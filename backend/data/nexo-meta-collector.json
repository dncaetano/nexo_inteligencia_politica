      "id": "aggregate-comments",
      "name": "Agregar Comentários",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [3100, 200]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst campaign = $('Loop Campanhas').item.json;\n\nconst totalComments = items.length;\nconst negativeComments = items.filter(i => i.json.sentiment === 'negative').length;\nconst positiveComments = items.filter(i => i.json.sentiment === 'positive').length;\nconst neutralComments = items.filter(i => i.json.sentiment === 'neutral').length;\n\nconst negativeRatio = totalComments > 0 ? negativeComments / totalComments : 0;\n\nconst alerts = [];\n\nif (negativeComments > 20) {\n  alerts.push({\n    campaign_id: campaign.id,\n    title: 'Alto volume de comentários negativos',\n    description: `${negativeComments} comentários negativos detectados nesta execução para a campanha \"${campaign.name}\"`,\n    severity: 'high',\n    status: 'open'\n  });\n}\n\nif (negativeRatio > 0.7 && totalComments >= 5) {\n  alerts.push({\n    campaign_id: campaign.id,\n    title: 'Sentimento negativo predominante',\n    description: `${Math.round(negativeRatio * 100)}% dos comentários são negativos na campanha \"${campaign.name}\"`,\n    severity: 'critical',\n    status: 'open'\n  });\n}\n\nconst postCommentCounts = {};\nitems.forEach(i => {\n  const postId = i.json.metadata?.post_id;\n  if (postId) {\n    postCommentCounts[postId] = (postCommentCounts[postId] || 0) + 1;\n  }\n});\n\nObject.entries(postCommentCounts).forEach(([postId, count]) => {\n  if (count > 50) {\n    alerts.push({\n      campaign_id: campaign.id,\n      title: 'Pico de comentários em post',\n      description: `Post ${postId} recebeu ${count} comentários nesta execução na campanha \"${campaign.name}\"`,\n      severity: 'medium',\n      status: 'open'\n    });\n  }\n});\n\nreturn {\n  campaign_id: campaign.id,\n  campaign_name: campaign.name,\n  total_comments: totalComments,\n  negative_comments: negativeComments,\n  positive_comments: positiveComments,\n  neutral_comments: neutralComments,\n  negative_ratio: negativeRatio,\n  alerts: alerts,\n  has_alerts: alerts.length > 0\n};"
      },
