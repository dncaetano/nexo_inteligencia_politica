    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Você é um analisador de sentimento especializado em comentários de redes sociais em português e inglês. Classifique o sentimento do comentário fornecido. Retorne APENAS um JSON válido com os campos: sentiment (positive, neutral ou negative), sentiment_score (número de 0 a 1 indicando a intensidade), justification (texto curto explicando a classificação)."
            },
            {
              "role": "user",
              "content": "=Analise o sentimento deste comentário: \"{{ $json.message }}\""
            }
          ]
        },
        "options": {
          "temperature": 0.1,
          "maxTokens": 200
        }
      },
      "id": "sentiment-analysis",
      "name": "Análise de Sentimento",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [2440, 200],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const comment = $('Loop Comentários').item.json;\nconst post = $('Loop Posts').item.json;\nconst campaign = $('Loop Campanhas').item.json;\nconst integration = $('Verificar Integração Meta').item.json[0];\n\nlet sentiment = 'neutral';\nlet sentiment_score = 0.5;\nlet justification = 'Análise não disponível';\n\ntry {\n  const openAiResponse = $input.item.json;\n  const content = openAiResponse?.choices?.[0]?.message?.content || openAiResponse?.message?.content || '';\n  if (content) {\n    const parsed = JSON.parse(content);\n    sentiment = parsed.sentiment || 'neutral';\n    sentiment_score = parsed.sentiment_score || 0.5;\n    justification = parsed.justification || '';\n  }\n} catch (e) {\n  // mantém defaults\n}\n\nconst metadata = {\n  post_id: post.id,\n  comment_id: comment.id,\n  author: comment.from?.name || 'unknown',\n  author_id: comment.from?.id || '',\n  reactions: post.reactions?.summary?.total_count || 0,\n  comments: post.comments?.summary?.total_count || 0,\n  like_count: comment.like_count || 0,\n  page_id: integration.page_id,\n  sentiment_justification: justification\n};\n\nreturn {\n  campaign_id: campaign.id,\n  source: 'meta',\n  entity_id: comment.id,\n  title: `Comentário de ${comment.from?.name || 'usuário'} em post do Facebook`,\n  content: comment.message || '',\n  sentiment: sentiment,\n  sentiment_score: sentiment_score,\n  url: post.permalink_url || '',\n  published_at: comment.created_time || new Date().toISOString(),\n  created_at: new Date().toISOString(),\n  metadata: metadata\n};"
      },
      "id": "prepare-mention",
      "name": "Preparar Dados Mention",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2660, 200]
    },
